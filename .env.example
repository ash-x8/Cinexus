# Supabase Configuration (Vercel / Vite supported)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# Alternative Next.js / Vercel style naming also supported:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# TMDB API Configuration (Optional - Default built-in fallback included)
VITE_TMDB_API_KEY=
VITE_TMDB_READ_ACCESS_TOKEN=

# Cloudinary CDN Configuration (Optional - Default built-in fallback included)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_API_KEY=
